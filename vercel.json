{
  "installCommand": "npm ci",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/gas",
      "dest": "api/gas.js"
    },
    {
      "src": "/gas/(.*)",
      "dest": "millet-mithai-backend/server.js/gas/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)\\.\\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|eot|js|css)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_GAS_URL": "https://script.google.com/macros/s/AKfycby4zvKZizbhoG0LVbdcruQqOC_rSaEUIP_yLZPfqWDCqaZpbDGaMr5HKmo9l0LRQK4v4g/exec"
  }
}
